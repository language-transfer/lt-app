{
  "name": "language-transfer",
  "main": "./index.js",
  "version": "2.1.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:maestro:report": "maestro test --format html --output artifacts/maestro/report.html --test-output-dir artifacts/maestro/results maestro/",
    "test:android:rapid-back": "bash scripts/test-android-rapid-back.sh",
    "test:full": "npm run test:coverage -- --runInBand && npm run test:maestro:report",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,json,md}\" \"src/**/*.{js,jsx,ts,tsx,json,md}\" \"components/**/*.{js,jsx,ts,tsx,json,md}\" \"hooks/**/*.{js,jsx,ts,tsx,json,md}\" \"constants/**/*.{js,jsx,ts,tsx,json,md}\" index.ts",
    "format-check": "prettier --check \"app/**/*.{js,jsx,ts,tsx,json,md}\" \"src/**/*.{js,jsx,ts,tsx,json,md}\" \"components/**/*.{js,jsx,ts,tsx,json,md}\" \"hooks/**/*.{js,jsx,ts,tsx,json,md}\" \"constants/**/*.{js,jsx,ts,tsx,json,md}\" index.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^3.0.0-next.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.7.5",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.11",
    "expo": "~54.0.25",
    "expo-application": "^7.0.8",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.19",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.9",
    "expo-network": "~8.0.7",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "format-duration": "^3.0.2",
    "jest": "^30.2.0",
    "lodash": "^4.17.21",
    "p-queue": "^9.0.1",
    "patch-package": "^8.0.1",
    "pretty-bytes": "^7.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-track-player": "^5.0.0-alpha0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/format-duration": "^3.0.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/pretty-bytes": "^5.1.0",
    "@types/react": "~19.1.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "roots": [
      "<rootDir>/src"
    ],
    "coverageDirectory": "artifacts/jest/coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ]
  }
}
